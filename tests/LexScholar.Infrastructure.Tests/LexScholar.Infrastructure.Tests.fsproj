<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <IsTestProject>true</IsTestProject>
    <IsPackable>false</IsPackable>
    <GenerateProgramFile>false</GenerateProgramFile>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../RunnerSmoke.fs" Link="RunnerSmoke.fs" />
    <Compile Include="SchemaTestSupport.fs" />
    <Compile Include="WorkspaceDbTests.fs" />
    <Compile Include="ProjectSchemaTests.fs" />
    <Compile Include="ProjectPersistenceTests.fs" />
    <Compile Include="DocumentSchemaTests.fs" />
    <Compile Include="PdfValidationTests.fs" />
    <Compile Include="LibraryTests.fs" />
    <Compile Include="StorageCleanupTests.fs" />
    <Compile Include="ContentAvailabilityTests.fs" />
    <Compile Include="PdfTextTests.fs" />
    <Compile Include="ChatCompletionsTests.fs" />
    <Compile Include="ChatGptCredentialsTests.fs" />
    <Compile Include="../LexScholar.Server.Tests/FakeOpenAi.fs" Link="FakeOpenAi.fs" />
    <Compile Include="OpenAiAuthTests.fs" />
    <Compile Include="ResponsesApiTests.fs" />
    <ProjectReference Include="../../src/LexScholar.Infrastructure/LexScholar.Infrastructure.fsproj" />
    <PackageReference Include="xunit.v3" />
    <None Include="../Fixtures/*" LinkBase="Fixtures" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../Fixtures/summary/*" LinkBase="Fixtures/summary" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
