    <Compile Include="../LexScholar.Server.Tests/FakeChatService.fs" Link="FakeChatService.fs" />
    <Compile Include="../LexScholar.Server.Tests/FakeOpenAi.fs" Link="FakeOpenAi.fs" />
    <Compile Include="Ui.fs" />
    <Compile Include="TextsTests.fs" />
    <Compile Include="SharedPiecesJourneyTests.fs" />
    <Compile Include="ProjectStateTests.fs" />
    <Compile Include="ProjectJourneyTests.fs" />
    <Compile Include="OnboardingJourneyTests.fs" />
    <Compile Include="LibraryStateTests.fs" />
    <Compile Include="LibraryJourneyTests.fs" />
    <Compile Include="LibraryExportJourneyTests.fs" />
    <Compile Include="LibraryExportStateTests.fs" />
    <Compile Include="LibraryDeletionStateTests.fs" />
    <Compile Include="LibraryDeletionJourneyTests.fs" />
    <Compile Include="LibraryControlsJourneyTests.fs" />
    <Compile Include="RoleApiTests.fs" />
    <Compile Include="SummaryStateTests.fs" />
    <Compile Include="SummaryJourneyTests.fs" />
    <Compile Include="WorkspaceJourneyTests.fs" />
    <Compile Include="PublishedWorkspaceJourneyTests.fs" />
    <Compile Include="MissingFileJourneyTests.fs" />
    <Compile Include="ChatGptStateTests.fs" />
    <Compile Include="ChatGptJourneyTests.fs" />
    <Compile Include="SummaryStatusStateTests.fs" />
    <Compile Include="BackgroundSummaryJourneyTests.fs" />
    <Compile Include="PreSendJourneyTests.fs" />
    <None Include="../Fixtures/**" LinkBase="Fixtures" CopyToOutputDirectory="PreserveNewest" />
    <ProjectReference Include="../../src/LexScholar.Server/LexScholar.Server.fsproj" />
    <PackageReference Include="Microsoft.Playwright" />
    <PackageReference Include="xunit.v3" />
  </ItemGroup>
</Project>
