// Native OpenCode 2.x. Role prompts and narrower permissions: .opencode/agents/.
{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "conductor",
  "commands": {
    "feature": {
      "description": "Give Sage product intent; Conductor coordinates the bounded feature",
      "agent": "conductor",
      "subagent": false,
      "template": "Take this owner's intent to Sage verbatim. Follow docs/agents/team.md through acceptance; establish the approved boundary before planning or implementation. Intent: $ARGUMENTS"
    }
  },
  "permissions": [
    { "action": "execute", "resource": "*", "effect": "deny" },
    { "action": "automation_*", "resource": "*", "effect": "deny" },
    { "action": "codecks_*", "resource": "*", "effect": "deny" },
    { "action": "codecks_get_context", "resource": "*", "effect": "allow" },
    { "action": "codecks_get_card", "resource": "*", "effect": "allow" },
    { "action": "codecks_search_cards", "resource": "*", "effect": "allow" },
    { "action": "subagent", "resource": "*", "effect": "deny" },
    { "action": "external_directory", "resource": "*", "effect": "ask" },
    { "action": "skill", "resource": "speckit-constitution", "effect": "deny" },
    { "action": "edit", "resource": ".specify/memory/constitution.md", "effect": "deny" },
    { "action": "shell", "resource": "*", "effect": "ask" },
    { "action": "shell", "resource": "git status *", "effect": "allow" },
    { "action": "shell", "resource": "git branch --show-current", "effect": "allow" },
    { "action": "shell", "resource": "git rev-parse --show-toplevel", "effect": "allow" },
    { "action": "shell", "resource": "git diff --check", "effect": "allow" },
    { "action": "shell", "resource": "git worktree list *", "effect": "allow" },
    { "action": "shell", "resource": "git add *", "effect": "allow" },
    { "action": "shell", "resource": "git commit -m *", "effect": "allow" },
    { "action": "shell", "resource": "scripts/team-branch.sh publish", "effect": "allow" },
    { "action": "shell", "resource": "gh pr create --base release/*", "effect": "allow" },
    { "action": "shell", "resource": "gh pr view *", "effect": "allow" },
    { "action": "shell", "resource": "gh pr checks *", "effect": "allow" },
    { "action": "shell", "resource": "git push *", "effect": "deny" },
    { "action": "shell", "resource": "git tag *", "effect": "deny" },
    { "action": "shell", "resource": "gh release *", "effect": "deny" },
    { "action": "shell", "resource": "gh pr merge *", "effect": "deny" },
    { "action": "shell", "resource": "scripts/integrate-pr*", "effect": "deny" },
    { "action": "shell", "resource": "scripts/gpt-review.sh *", "effect": "deny" }
  ],
  "mcp": {
    "servers": {
      "codecks": { "type": "remote", "url": "https://mcp.codecks.io/mcp" }
    }
  }
}
