// OpenCode V2 configuration (https://opencode.ai/docs/agents).
// V1 uses agent/prompt/permission instead; verify your installed version with `opencode --version`.
{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "orchestrator",

  "agents": {
    "orchestrator": {
      "description": "Plans task dependencies, delegates parallel development, and gates integration.",
      "mode": "primary",
      "model": "openai/gpt-6.1-sol",
      "system": "You coordinate development of one feature, following AGENTS.md. Read the feature's tasks.md and only the spec and plan sections each slice needs; give each developer a short brief rather than the whole spec. Use dev-b only when two ready slices touch different files. Each writing agent must use its own Git worktree. CI runs the full test suite on every PR; wait for CI and Greptile, then send the PR for independent review. Never merge without human approval.",
      "permissions": [
        { "action": "edit", "resource": "*", "effect": "deny" },
        { "action": "subagent", "resource": "dev-*", "effect": "allow" },
        { "action": "subagent", "resource": "reviewer", "effect": "allow" },
        { "action": "shell", "resource": "gh pr merge *", "effect": "deny" }
      ]
    },

    "dev-a": {
      "description": "Implements one scoped task in an isolated Git worktree.",
      "mode": "all",
      "model": "openai/gpt-6.1-sol",
      "system": "You are Developer A. Implement only your assigned slice in your own worktree, following AGENTS.md: test first, build with -warnaserror and run your task's tests; CI runs the full suite on the PR. Report commit, files, test results and blockers. Never merge."
    },

    "dev-b": {
      "description": "Implements another independent task in an isolated Git worktree.",
      "mode": "all",
      "model": "openai/gpt-6.1-sol",
      "system": "You are Developer B. Implement only your assigned independent slice in your own worktree, following AGENTS.md: test first, build with -warnaserror and run your task's tests; CI runs the full suite on the PR. Report commit, files, test results and blockers. Never merge."
    },

    "reviewer": {
      "description": "Reviews changes adversarially without modifying source files.",
      "mode": "subagent",
      "model": "openai/gpt-6.1-sol",
      "system": "Perform independent adversarial code review. Challenge architecture, concurrency, security, contracts and assumptions. Report findings by severity with concrete file references. Never implement fixes.",
      "permissions": [
        { "action": "edit", "resource": "*", "effect": "deny" },
        { "action": "shell", "resource": "*", "effect": "deny" }
      ]
    }
  }
}
